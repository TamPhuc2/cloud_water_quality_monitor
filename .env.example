# ============================================================
# Water Quality Cloud Pipeline - Environment Configuration
# Copy to .env and replace placeholder values before running.
# NEVER commit .env to Git.
# ============================================================

# --- Kafka (KRaft on AWS EC2) ---
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_TOPIC=water-quality-events
KAFKA_PARTITIONS=3
KAFKA_CONSUMER_GROUP=water-quality-consumer
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092

# --- Neon Serverless PostgreSQL 16 (ap-southeast-1) ---
# Get these from Neon Console -> Connection Details -> Pooled connection
NEON_HOST=ep-your-endpoint-pooler.ap-southeast-1.aws.neon.tech
NEON_DB=neondb
NEON_USER=neondb_owner
NEON_PASSWORD=CHANGE_ME_NEON_PASSWORD
PG_SSLMODE=require
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME_NEON_PASSWORD@ep-your-endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- Consumer Runtime (12-Factor Env Knobs) ---
# CONSUMER_MODE: "batch" (normal/high-throughput) or "single" (baseline comparison)
CONSUMER_MODE=batch
CONSUMER_BATCH_SIZE=100
CONSUMER_BATCH_TIMEOUT_MS=500

# --- Fault-Injection for Crash Recovery Test (set to false in normal demo) ---
CONSUMER_CRASH_AFTER_DB_COMMIT=false
CONSUMER_CRASH_TARGET_INDEX=0

LOG_LEVEL=INFO
